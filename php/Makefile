# The PHP binding is a pure-FFI consumer of the prebuilt libkcl shared
# library: `composer install` fetches the protobuf PHP runtime, the vendored
# generated messages under src/Api come from protoc, and the typed AST under
# src/Ast is generated by tools/generate_ast.py (shared with the other
# generated bindings; run it from the repository root).
#
# Pinned tools:
# - protoc 36.2 generates src/Api (pinned like the other pinned gencode in
#   ../spec/Makefile; the google/protobuf PHP runtime 4.33.x is the matching
#   runtime and is what composer.json requires). Regenerate with:
#       protoc --php_out=src/Api -I ../spec ../spec/spec.proto
# - PHP >= 8.1 with the FFI extension (always enabled on CLI; web SAPIs need
#   ffi.enable=true, see README.md).

.PHONY: test proto install

install:
	composer install

proto:
	protoc --php_out=src/Api -I ../spec ../spec/spec.proto

test: install
	./vendor/bin/phpunit
