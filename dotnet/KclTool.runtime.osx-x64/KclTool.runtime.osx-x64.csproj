<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runtime asset package for KclTool on macOS x64 (Intel). Ships only the
    native binaries (kcl + libkcl.dylib); no managed code. The parent
    KclTool package pulls this in via <PackageReference>, and the .NET
    runtime asset resolver selects the matching RID at consumer restore time.
  -->

  <PropertyGroup>
    <PackageId>KclTool.runtime.osx-x64</PackageId>
    <Title>KclTool runtime assets (osx-x64)</Title>
    <Description>
Native binaries (kcl, libkcl.dylib) for KclTool on macOS x64 (Intel).
Consumed via the matching KclTool dependency; pull KclTool directly in
your project and the right per-RID package is restored automatically.
    </Description>

    <!-- Runtime asset package: no managed code, only native files. -->
    <TargetFramework>net8.0</TargetFramework>
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Record the target RID in runtime.json so NuGet can identify this as
         a RID-specific asset package. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <None Include="kcl">
      <Pack>true</Pack>
      <PackagePath>runtimes/osx-x64/native/</PackagePath>
    </None>
    <None Include="libkcl.dylib">
      <Pack>true</Pack>
      <PackagePath>runtimes/osx-x64/native/</PackagePath>
    </None>
  </ItemGroup>

</Project>