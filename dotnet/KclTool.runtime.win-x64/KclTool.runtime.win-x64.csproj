<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runtime asset package for KclTool on Windows x64. Ships only the native
    binaries (kcl.exe + kcl.dll); no managed code. The parent KclTool package
    pulls this in via <PackageReference>, and the .NET runtime asset resolver
    selects the matching RID at consumer restore time.
  -->

  <PropertyGroup>
    <PackageId>KclTool.runtime.win-x64</PackageId>
    <Title>KclTool runtime assets (win-x64)</Title>
    <Description>
Native binaries (kcl.exe, kcl.dll) for KclTool on Windows x64. Consumed via
the matching KclTool dependency; pull KclTool directly in your project and
the right per-RID package is restored automatically.
    </Description>

    <!-- Runtime asset package: no managed code, only native files. -->
    <TargetFramework>net8.0</TargetFramework>
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Record the target RID in runtime.json so NuGet can identify this as
         a RID-specific asset package. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <None Include="kcl.exe">
      <Pack>true</Pack>
      <PackagePath>runtimes/win-x64/native/</PackagePath>
    </None>
    <None Include="kcl.dll">
      <Pack>true</Pack>
      <PackagePath>runtimes/win-x64/native/</PackagePath>
    </None>
  </ItemGroup>

</Project>