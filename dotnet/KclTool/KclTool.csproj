<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>KclTool</AssemblyName>
    <PackageId>KclTool</PackageId>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>KclTool</Title>
    <PackageDescription>
KCL CLI for .NET — bundles the cross-platform `kcl` (or `kcl.exe` on Windows) executable and its native dependency `libkcl` via per-RID runtime asset packages (`KclTool.runtime.&lt;rid&gt;`), so .NET applications can shell out to KCL without a separate install. .NET's runtime asset resolver selects the matching RID at restore time.
    </PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The native binaries live in per-RID runtime asset packages so each
    .nupkg stays well below NuGet's per-package size limit. Listing all
    five as unconditional <PackageReference>s keeps the .nuspec simple;
    the .NET runtime asset resolver still only copies the matching RID's
    `runtimes/<rid>/native/*` files into the consumer's output directory.
  -->
  <ItemGroup>
    <PackageReference Include="KclTool.runtime.win-x64" Version="$(Version)" />
    <PackageReference Include="KclTool.runtime.linux-x64" Version="$(Version)" />
    <PackageReference Include="KclTool.runtime.linux-arm64" Version="$(Version)" />
    <PackageReference Include="KclTool.runtime.osx-x64" Version="$(Version)" />
    <PackageReference Include="KclTool.runtime.osx-arm64" Version="$(Version)" />
  </ItemGroup>

</Project>